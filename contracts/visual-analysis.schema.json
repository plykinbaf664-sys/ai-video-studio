{
 "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["version","contextSha256","sourceSha256","observations","limitations"],
 "properties":{
  "version":{"const":1},"contextSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sourceSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "observations":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/observation"}},
  "limitations":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"string","minLength":3,"maxLength":500}}
 },
 "$defs":{
  "box":{"type":"object","additionalProperties":false,"required":["x","y","width","height"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"width":{"type":"number","exclusiveMinimum":0,"maximum":1},"height":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
  "observation":{"type":"object","additionalProperties":false,"required":["unitId","frameIds","confidence","whatHappens","face","person","importantObjects","freeAreas","motion","expression","lighting","decision"],"properties":{
   "unitId":{"type":"string","minLength":1,"maxLength":64},"frameIds":{"type":"array","minItems":2,"maxItems":120,"uniqueItems":true,"items":{"type":"string","pattern":"^f[0-9]{4}$"}},
   "confidence":{"type":"number","minimum":0,"maximum":1},"whatHappens":{"type":"string","minLength":5,"maxLength":700},
   "face":{"anyOf":[{"$ref":"#/$defs/box"},{"type":"null"}]},"person":{"anyOf":[{"$ref":"#/$defs/box"},{"type":"null"}]},
   "importantObjects":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["kind","box","confidence","reason"],"properties":{"kind":{"enum":["hand","phone","tablet","microphone","other"]},"box":{"$ref":"#/$defs/box"},"confidence":{"type":"number","minimum":0,"maximum":1},"reason":{"type":"string","minLength":3,"maxLength":300}}}},
   "freeAreas":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/box"}},
   "motion":{"type":"object","additionalProperties":false,"required":["level","description"],"properties":{"level":{"enum":["low","medium","high","unknown"]},"description":{"type":"string","minLength":3,"maxLength":500}}},
   "expression":{"type":"object","additionalProperties":false,"required":["description","confidence"],"properties":{"description":{"type":"string","minLength":3,"maxLength":400},"confidence":{"type":"number","minimum":0,"maximum":1}}},
   "lighting":{"type":"object","additionalProperties":false,"required":["changed","description"],"properties":{"changed":{"type":["boolean","null"]},"description":{"type":"string","minLength":3,"maxLength":400}}},
   "decision":{"type":"object","additionalProperties":false,"required":["thoughtWordIds","presentation","reason","whyNoMore","zoom","styleNotes"],"properties":{
    "thoughtWordIds":{"type":"array","minItems":1,"maxItems":40,"uniqueItems":true,"items":{"type":"string","pattern":"^w[0-9]{5}$"}},
    "presentation":{"enum":["retain","protect-gesture","protect-face","avoid-graphics"]},"reason":{"type":"string","minLength":8,"maxLength":700},"whyNoMore":{"type":"string","minLength":8,"maxLength":500},
    "zoom":{"const":"none"},"styleNotes":{"type":"object","additionalProperties":false,"required":["editorial-focus","signal-dynamic","dry-irony"],"properties":{"editorial-focus":{"type":"string","minLength":5,"maxLength":400},"signal-dynamic":{"type":"string","minLength":5,"maxLength":400},"dry-irony":{"type":"string","minLength":5,"maxLength":400}}}
   }}
  }}
 }
}
