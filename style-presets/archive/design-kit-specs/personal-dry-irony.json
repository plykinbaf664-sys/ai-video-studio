  "sourceRules": [
    "audible-first captions",
    "original and final timeline mapping",
    "no baked-in subtitle duplicates",
    "spatial safety zones",
    "licensed assets only"
  ],
  "constraints": {
    "previewTextOnly": true,
    "requiresActualSourceVideoForRealMontage": true,
    "notACompleteAutomaticEditor": true
  }
