  "rules": {
    "rhythm": {
      "source": "edit-plan",
      "keepCompleteWords": true,
      "minimumLeadMs": 120,
      "minimumTailMs": 120
    },
    "subtitles": {
      "maximumLines": 2,
      "maximumWordsPerGroup": 6,
      "maximumCharactersPerGroup": 44,
      "splitGapMs": 450,
      "tailMs": 140,
      "quotesFromRetainedSpeechOnly": true
    },
    "graphics": {
      "components": [
        "subtitles",
        "quote-callout",
        "semantic-brackets",
        "split-quotes",
        "step-indicator"
      ],
      "maximumConcurrentFocus": 1,
      "insertionPolicy": "semantic_only"
    },
    "motion": {
      "quoteFadeFrames": 5,
      "reframe": "none"
    },
    "sound": {
      "preserveOriginalVoice": true,
      "music": "none",
      "soundEffects": "semantic-only"
    },
    "transitions": {
      "kind": "cut",
      "durationFrames": 0
    },
    "framing": {
      "objectFit": "contain",
      "automaticSubjectDetection": false
    }
  },
  "design": {
    "font": {
      "assetId": "personal-onest",
      "family": "PersonalOnest",
      "runtimeFile": "generated/assets/fonts/personal-onest.ttf",
      "subtitleWeight": 600,
      "headingWeight": 820
    },
    "slot": {
      "x": 104,
      "y": 168,
      "width": 772,
      "maxHeight": 184
