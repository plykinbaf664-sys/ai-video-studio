      "right": 180,
      "top": 140,
      "bottom": 300
    },
    "subtitle": {
      "preferredSize": 56,
      "minSize": 50,
      "lineHeight": 1.16
    },
    "heading": {
      "preferredSize": 66,
      "minSize": 60,
      "lineHeight": 1.1
    },
    "card": {
      "paddingX": 24,
      "paddingY": 14,
      "radius": 16,
      "background": "rgba(17,19,25,0.90)",
      "text": "#F6F3EC",
      "border": "rgba(246,243,236,0.16)"
    }
  }
