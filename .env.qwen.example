# Copy to .env.qwen. Never paste the API key into chat or commit it.
# Disabled until you explicitly enable and approve a particular payload.
QWEN_ENABLED=false
QWEN_API_KEY=
# Choose the region of your workspace and API key.
# ap-southeast-1 | cn-beijing | us-east-1 | eu-central-1 | ap-northeast-1 | cn-hongkong
QWEN_REGION=
# Copy the OpenAI-compatible endpoint from that workspace's console:
# https://ws-0k3rkeh9pgddyrz7.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
# Exact available Qwen model id supporting non-thinking JSON Object mode.
QWEN_MODEL=
QWEN_TIMEOUT_MS=120000
QWEN_MAX_OUTPUT_TOKENS=8192
QWEN_MAX_INPUT_BYTES=131072
QWEN_MAX_RESPONSE_BYTES=1048576
